{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "folio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FRONTEND_URL": "https://folioink.vercel.app/books"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
